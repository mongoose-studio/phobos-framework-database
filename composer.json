{
    "name": "mongoose-studio/phobos-framework-database",
    "description": "Phobos Framework Database Layer",
    "version": "3.2.1",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "mongoose-studio/phobos-framework": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "mongoose-studio/phobos-framework-database-sqlite": "^3.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../phobos-framework"
        },
        {
            "type": "path",
            "url": "../phobos-framework-database-sqlite"
        }
    ],
    "authors": [
        {
            "name": "Marcel Rojas",
            "email": "marcelrojas16@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PhobosFramework\\Database\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PhobosFramework\\Database\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "export XDEBUG_MODE=coverage && phpunit --coverage-html coverage"
    }
}
